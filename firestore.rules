rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserSave(data, userId) {
      return data.keys().hasAll(['saveId', 'userId', 'slotName', 'timestamp', 'simHour', 'simDay']) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.saveId is string && data.saveId.size() <= 128 &&
             data.slotName is string && data.slotName.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.simHour is number && data.simDay is number &&
             (!('folder' in data) || (data.folder is string && data.folder.size() <= 64)) &&
             (!('isAutoSave' in data) || data.isAutoSave is bool) &&
             (!('characterCount' in data) || data.characterCount is number) &&
             (!('characters' in data) || (data.characters is string && data.characters.size() <= 65536)) &&
             (!('objects' in data) || (data.objects is string && data.objects.size() <= 65536)) &&
             (!('mechanicsData' in data) || (data.mechanicsData is string && data.mechanicsData.size() <= 32768)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName']) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('autoSaveEnabled' in data) || data.autoSaveEnabled is bool) &&
             (!('autoSaveIntervalSeconds' in data) || data.autoSaveIntervalSeconds is number) &&
             (!('lastSavedSlot' in data) || (data.lastSavedSlot is string && data.lastSavedSlot.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      match /saves/{saveId} {
        allow get: if isValidId(userId) && isValidId(saveId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(saveId) && isOwner(userId) && isValidUserSave(request.resource.data, userId);
        allow update: if isValidId(userId) && isValidId(saveId) && isOwner(userId) && isValidUserSave(request.resource.data, userId);
        allow delete: if isValidId(userId) && isValidId(saveId) && isOwner(userId);
      }

      match /profile/{configId} {
        allow get: if isValidId(userId) && isValidId(configId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(configId) && isOwner(userId) && isValidUserProfile(request.resource.data, userId);
        allow update: if isValidId(userId) && isValidId(configId) && isOwner(userId) && isValidUserProfile(request.resource.data, userId);
        allow delete: if isValidId(userId) && isValidId(configId) && isOwner(userId);
      }
    }
  }
}
